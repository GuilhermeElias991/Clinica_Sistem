# Variáveis do back-end (todas opcionais em desenvolvimento).
# Copie para .env e ajuste. O .env NÃO vai para o git.

# Banco — sem estas três a API usa um H2 em arquivo (backend/data/)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/odonto
SPRING_DATASOURCE_USERNAME=odonto
SPRING_DATASOURCE_PASSWORD=troque_esta_senha

# Chave do JWT: no mínimo 32 caracteres. OBRIGATÓRIO trocar em produção.
JWT_SECRET=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
JWT_EXPIRATION_HOURS=8

# Administrador criado na primeira subida (senha guardada em BCrypt)
ADMIN_EMAIL=admin@odonto.com
ADMIN_PASSWORD=123456
ADMIN_NAME=Recepção

# Carregar dados de exemplo quando o banco estiver vazio
SEED_DEMO=true

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

PORT=8080
APP_TIMEZONE=America/Sao_Paulo
